#!/bin/bash
# Undo setup: remove this plugin's marked blocks and helper, give the keys back to the keyboard.
set -euo pipefail

# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"

usage() {
  cat <<EOF
Usage: uninstall [--dry-run] [--yes]

Removes what setup added: the marked blocks in Solaar's rules, Hyprland's
bindings and autostart, the Show Desktop helper, and the key diversion.
Lines you added yourself, outside the marked blocks, are left alone.

  --dry-run, -n   show every change without making it
  --yes, -y       accept the changes without asking
EOF
}

parse_args "$@"

say "POP Icon Keys uninstall will change these files (each is backed up first):"
has_block "$RULES_FILE" "#" && say "  $RULES_FILE    remove the key rules block"
[[ -e $SHOW_DESKTOP ]] && say "  $SHOW_DESKTOP    delete"
command -v solaar >/dev/null 2>&1 && say "  $SOLAAR_CONFIG    set the five mapped keys back to Regular (Solaar is restarted)"
has_block "$BINDINGS_FILE" "--" && say "  $BINDINGS_FILE    remove the Lock key binding block"
has_block "$AUTOSTART_FILE" "--" && say "  $AUTOSTART_FILE    remove the Solaar autostart block"
say ""
confirm "Apply these changes?" || { say "Nothing changed."; exit 1; }
(( DRY_RUN )) && say "Dry run: showing the changes, writing nothing."

if has_block "$RULES_FILE" "#"; then
  backup "$RULES_FILE"
  write_block "$RULES_FILE" "#" ""
fi

[[ -e $SHOW_DESKTOP ]] && run rm -f -- "$SHOW_DESKTOP"

if command -v solaar >/dev/null 2>&1; then
  was_running=0
  [[ -n $(solaar_pids) ]] && was_running=1
  backup "$SOLAAR_CONFIG"
  stop_solaar
  set_diversion 0 || warn "no saved Solaar entry for \"$DEVICE\"; nothing to reset"
  (( was_running )) && start_solaar
fi

if has_block "$BINDINGS_FILE" "--"; then
  backup "$BINDINGS_FILE"
  write_block "$BINDINGS_FILE" "--" ""
fi

if has_block "$AUTOSTART_FILE" "--"; then
  backup "$AUTOSTART_FILE"
  write_block "$AUTOSTART_FILE" "--" ""
fi

reload_hyprland

say ""
if (( DRY_RUN )); then say "Dry run complete; nothing was written."; else say "Done. The top row sends the keyboard's own shortcuts again."; fi
say "To remove the plugin itself: omarchy plugin remove io.github.poornan.pop-icon-keys"
