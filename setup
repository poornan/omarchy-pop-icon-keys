#!/bin/bash
# Map the Logitech POP Icon Keys top row to Omarchy actions through Solaar.
# Safe to re-run: every change lives in a marked block that is replaced, not duplicated.
set -euo pipefail

# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"

usage() {
  cat <<EOF
Usage: setup [--dry-run] [--yes]

Maps the POP Icon Keys top row through Solaar:
  F4 Show Desktop   -> empty workspace (press again to return)
  F5 Search         -> Omarchy app launcher
  F6 Dictation      -> omarchy-dictation toggle
  F7 Emoji          -> Omarchy emoji picker
  F8 Screen Capture -> region screenshot
  Lock (Fn+last)    -> omarchy-system-lock

  --dry-run, -n   show each change (as a diff) without making it
  --yes, -y       accept the changes without asking (does not install Solaar)

Exit status: 0 done (or declined), 1 error (see message), 2 partly applied
(the keys could not be diverted yet; connect the keyboard and run setup again).
EOF
}

parse_args "$@"

# --- Preflight (reads only) -----------------------------------------------------

preflight
take_lock
load_keys

solaar_installed=1
command -v solaar >/dev/null 2>&1 || solaar_installed=0

# Broken marker lines or unreadable files stop setup here, before anything changes.
for f in "$RULES_FILE:#" "$BINDINGS_FILE:--" "$AUTOSTART_FILE:--"; do
  has_block "${f%:*}" "${f##*:}" || true
done

# An existing Lock binding of the user's own, in Omarchy's usual spelling.
lock_bind_unmarked=0
if [[ -f $BINDINGS_FILE ]] && ! has_block "$BINDINGS_FILE" "--" \
  && grep -qE '^[[:space:]]*o\.bind\("SUPER \+ CTRL \+ Q"' "$BINDINGS_FILE"; then
  lock_bind_unmarked=1
fi

# Any uncommented line that mentions solaar counts as starting it already.
autostart_unmarked=0
if [[ -f $AUTOSTART_FILE ]] && ! has_block "$AUTOSTART_FILE" "--" \
  && grep -qE '^[[:space:]]*[^-[:space:]].*solaar' "$AUTOSTART_FILE"; then
  autostart_unmarked=1
fi

copies=() others=()
if [[ -f $RULES_FILE ]]; then
  scan=$(rules_scan)
  while IFS=$'\t' read -r kind key; do
    [[ $kind == plugin ]] && copies+=("$key")
    [[ $kind == other ]] && others+=("$key")
  done <<<"$scan"
fi

hypr_planned=0

# --- Plan and consent ---------------------------------------------------------

say "POP Icon Keys setup will change these files. A file edited in place is backed"
say "up first (as <file>.bak.$MARK.<time>, newest 3 kept), and only if it changes:"
say "  $RULES_FILE    add the key rules in a marked block"
(( ${#copies[@]} )) && say "      and remove earlier copies of this plugin's rules for: $(IFS=,; echo "${copies[*]}")"
say "  $SHOW_DESKTOP    install the Show Desktop helper"
say "  $SOLAAR_CONFIG    divert the five mapped keys to Solaar"
say "      (Solaar is stopped while this file is edited, then started; it routes the keys)"
if (( lock_bind_unmarked )); then
  say "  $BINDINGS_FILE    unchanged: SUPER + CTRL + Q is already bound there"
elif [[ -f $BINDINGS_FILE ]]; then
  say "  $BINDINGS_FILE    bind the Lock key (SUPER + CTRL + Q) to omarchy-system-lock"
  hypr_planned=1
fi
if (( autostart_unmarked )); then
  say "  $AUTOSTART_FILE    unchanged: Solaar already starts at login"
elif [[ -f $AUTOSTART_FILE ]]; then
  say "  $AUTOSTART_FILE    start Solaar hidden at login"
  hypr_planned=1
else
  say "  (no $AUTOSTART_FILE: start Solaar at login yourself)"
fi
(( hypr_planned )) && say "  Hyprland is reloaded if either Hyprland file changes"
if (( ${#others[@]} )); then
  warn "$RULES_FILE has other rules of yours for: $(IFS=,; echo "${others[*]}")."
  warn "They are left alone, and both would run on each press. Remove them if you no longer want them."
fi
say ""

if (( ! solaar_installed )); then
  say "Solaar is not installed. It is the Logitech device manager that routes these keys."
  if (( DRY_RUN )); then
    say "  [dry-run] setup would stop here until Solaar is installed (omarchy pkg add solaar)"
    exit 0
  fi
  (( ASSUME_YES )) && die "install Solaar first (omarchy pkg add solaar), then run setup again"
  command -v omarchy-pkg-add >/dev/null 2>&1 || die "install Solaar first, then run setup again"
  confirm "Install it now with 'omarchy pkg add solaar' (it may ask for your password)?" \
    || { say "Nothing changed."; exit 0; }
  omarchy-pkg-add solaar || die "Solaar was not installed; nothing else was changed"
  command -v solaar >/dev/null 2>&1 || die "Solaar is still not on PATH; nothing else was changed"
fi

confirm "Apply these changes?" || { say "Nothing changed."; exit 0; }
(( DRY_RUN )) && say "Dry run: showing the changes, writing nothing."

# --- From here on files change ---------------------------------------------------
# However setup ends (an error, Ctrl-C, the terminal closing), a Solaar it stopped
# is started again, and a failure after the first change says how to recover.

changes_started=0
solaar_armed=0
skipped=()

on_exit() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if (( solaar_armed )); then
    solaar_armed=0
    restart_solaar || true
  fi
  if (( rc != 0 && rc != 2 && changes_started )); then
    printf '\n%s\n' "Setup stopped partway (see the error above). Files it changed were backed up" >&2
    printf '%s\n' "as <file>.bak.$MARK.<time>. Fix the problem and run setup again, or run uninstall to undo." >&2
  fi
  exit "$rc"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

(( DRY_RUN )) || changes_started=1

# --- Solaar rules and the Show Desktop helper ------------------------------------
# First: on their own they do nothing (the keys are not diverted yet), so a
# failure here leaves the keyboard working as before.

run mkdir -p "$SOLAAR_DIR"
if [[ ! -s $RULES_FILE ]] && (( ! DRY_RUN )); then
  # Solaar reads rules.yaml as a YAML 1.3 multi-document stream.
  printf '%%YAML 1.3\n' >"$RULES_FILE" || die "cannot write $RULES_FILE"
fi
if (( ${#copies[@]} )); then
  edit rules-drop-copies "$RULES_FILE" "$SHOW_DESKTOP" || die "$RULES_FILE was left unchanged"
fi
body=$(edit rules-body "$SHOW_DESKTOP") || die "could not build the rules"
write_block "$RULES_FILE" "#" "$body"

run mkdir -p "$BIN_DIR"
run install -m 755 "$PLUGIN_DIR/bin/pop-icon-keys-show-desktop" "$SHOW_DESKTOP" \
  || die "could not install $SHOW_DESKTOP"

# --- Key diversion (persisted in Solaar's config) -----------------------------

diverted=1
solaar_armed=1
stop_solaar || die "Solaar did not stop, so the keys could not be diverted safely. $SOLAAR_CONFIG was not changed."

status=0
set_diversion 1 || status=$?
if (( status == 3 )); then
  # Solaar has not saved this keyboard yet: let it see the keyboard once, then try again.
  say "Solaar has no saved entry for \"$DEVICE\" yet; starting it once to record the keyboard."
  if (( ! DRY_RUN )); then
    restart_solaar || true
    sleep 6
    stop_solaar || die "Solaar did not stop, so the keys could not be diverted. $SOLAAR_CONFIG was not changed."
    status=0
    set_diversion 1 || status=$?
  fi
  if (( status == 3 )); then
    diverted=0
    warn "Solaar still has no entry for \"$DEVICE\". The rules are installed, but the keys are not diverted yet."
  fi
fi
(( status == 0 || status == 3 )) || die "could not update $SOLAAR_CONFIG (see above); it was left unchanged"

solaar_armed=0
restart_solaar || skipped+=("start Solaar (run: solaar --window=hide)")

# --- Lock key and autostart -----------------------------------------------------

hypr_changed=0
if (( ! lock_bind_unmarked )) && [[ -f $BINDINGS_FILE ]]; then
  write_block "$BINDINGS_FILE" "--" \
'-- Logitech POP Icon Keys: the Lock key (Fn + last key) sends SUPER + CTRL + Q, the macOS lock shortcut.
o.bind("SUPER + CTRL + Q", "Lock screen", "omarchy-system-lock")'
  (( LAST_CHANGED )) && hypr_changed=1
elif [[ ! -f $BINDINGS_FILE ]]; then
  skipped+=("bind the Lock key: no $BINDINGS_FILE (bind SUPER + CTRL + Q to omarchy-system-lock yourself)")
fi

if (( ! autostart_unmarked )) && [[ -f $AUTOSTART_FILE ]]; then
  write_block "$AUTOSTART_FILE" "--" \
'-- Solaar in the background routes the POP Icon Keys top row (pop-icon-keys plugin).
o.launch_on_start("solaar --window=hide")'
  (( LAST_CHANGED )) && hypr_changed=1
elif [[ ! -f $AUTOSTART_FILE ]]; then
  skipped+=("start Solaar at login: no $AUTOSTART_FILE (add solaar --window=hide to your autostart)")
fi

if (( hypr_changed )); then
  reload_hyprland || skipped+=("reload Hyprland (the Lock key works after your next login)")
fi

# --- Summary --------------------------------------------------------------------

say ""
if (( DRY_RUN )); then
  say "Dry run complete; nothing was written."
  exit 0
fi
if (( ${#skipped[@]} )); then
  say "Not done:"
  for s in "${skipped[@]}"; do say "  - $s"; done
fi
if (( ! diverted )); then
  say "Partly applied: the rules are in place, but the keys are not diverted yet."
  say "Turn the keyboard on (or press a key to wake it), then run setup again."
  exit 2
fi
if (( ${#skipped[@]} )); then
  say "Applied, except for the steps above. Try F4 to F8 and the Lock key."
else
  say "Done. Try F4 to F8 and the Lock key. Settings stay in place after a restart."
fi
