#!/bin/bash
# Print the keyboard's state as key=value lines for the bar widget.
#   installed=0|1  running=0|1  connected=0|1  battery=<0-100 or empty>
#   diverted=<mapped keys the keyboard is sending to Solaar right now>
#   saved=<mapped keys Solaar's saved settings divert>
#   missing=<mapped keys not diverted in Solaar's saved settings: run setup>
#   inactive=<mapped keys diverted in the saved settings but not on the keyboard
#             right now, which happens after the keyboard sleeps or reconnects>
set -uo pipefail

DEVICE="POP Icon Keys"
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=../lib/solaar-procs.sh
source "$HERE/../lib/solaar-procs.sh"
# The mapped keys, from the plugin's single key list.
MAPPED=()
while IFS=$'\t' read -r _ name; do [[ -n $name ]] && MAPPED+=("$name"); done \
  < <(python3 -I "$HERE/../lib/edit.py" keys 2>/dev/null)
(( ${#MAPPED[@]} )) || MAPPED=("Show Desktop" "MultiPlatform Search" "Dictation" "Emoji" "Screen Capture")

if ! command -v solaar >/dev/null 2>&1; then
  printf 'installed=0\nrunning=0\nconnected=0\nbattery=\ndiverted=\nsaved=\nmissing=\ninactive=\n'
  exit 0
fi

running=0
[[ -n $(solaar_daemon_pids) ]] && running=1

out=$(timeout 20 solaar show "$DEVICE" 2>/dev/null || true)

connected=0
battery=""
live=""
saved_line=""
if [[ -n $out ]]; then
  battery=$(grep -m1 -oE 'Battery: [0-9]+%' <<<"$out" | grep -oE '[0-9]+' || true)
  # `solaar show` prints two lines: what Solaar saved, and what the keyboard reports now.
  saved_line=$(grep -m1 -E 'Key/Button Diversion \(saved\) *:' <<<"$out" || true)
  live=$(grep -m1 -E 'Key/Button Diversion +:' <<<"$out" || true)
  [[ -n $battery || -n $live ]] && connected=1
fi

diverted=() saved=() missing=() inactive=()
for key in "${MAPPED[@]}"; do
  is_live=0 is_saved=0
  [[ $live == *"$key:Diverted"* ]] && is_live=1
  [[ $saved_line == *"$key:Diverted"* ]] && is_saved=1
  # Older Solaar versions print no saved line; then the live line is all there is.
  [[ -z $saved_line ]] && is_saved=$is_live
  (( is_live )) && diverted+=("$key")
  (( is_saved )) && saved+=("$key")
  if (( ! is_saved )); then
    missing+=("$key")
  elif (( ! is_live )); then
    inactive+=("$key")
  fi
done
(( connected )) || { missing=(); inactive=(); }

join() { local IFS=,; echo "$*"; }
printf 'installed=1\nrunning=%s\nconnected=%s\nbattery=%s\ndiverted=%s\nsaved=%s\nmissing=%s\ninactive=%s\n' \
  "$running" "$connected" "$battery" "$(join "${diverted[@]}")" "$(join "${saved[@]}")" \
  "$(join "${missing[@]}")" "$(join "${inactive[@]}")"
